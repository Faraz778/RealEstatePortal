<!doctype html>
<html lang="en">
  <!--begin::Head-->
  <head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <title>AdminLTE v4 | Dashboard</title>

    <!--begin::Accessibility Meta Tags-->
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=yes" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#007bff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1a1a1a" media="(prefers-color-scheme: dark)" />
    <!--end::Accessibility Meta Tags-->

    <!--begin::Primary Meta Tags-->
    <meta name="title" content="AdminLTE v4 | Dashboard" />
    <meta name="author" content="ColorlibHQ" />
    <meta
      name="description"
      content="AdminLTE is a Free Bootstrap 5 Admin Dashboard, 30 example pages using Vanilla JS. Fully accessible with WCAG 2.1 AA compliance."
    />
    <meta
      name="keywords"
      content="bootstrap 5, bootstrap, bootstrap 5 admin dashboard, bootstrap 5 dashboard, bootstrap 5 charts, bootstrap 5 calendar, bootstrap 5 datepicker, bootstrap 5 tables, bootstrap 5 datatable, vanilla js datatable, colorlibhq, colorlibhq dashboard, colorlibhq admin dashboard, accessible admin panel, WCAG compliant"
    />
    <!--end::Primary Meta Tags-->

    <!--begin::Accessibility Features-->
    <!-- Skip links will be dynamically added by accessibility.js -->
    <meta name="supported-color-schemes" content="light dark" />
    <link rel="preload" href="~/Admin/css/adminlte.css" as="style" />
    <!--end::Accessibility Features-->

    <!--begin::Fonts-->
    @* <link
      rel="stylesheet"
     <!-- href="https://cdn.jsdelivr.net/npm/@fontsource/source-sans-3@5.0.12/index.css" -->
      integrity="sha256-tXJfXfp6Ewt1ilPzLDtQnJV4hclT9XuaZUKyUvmyr+Q="
      crossorigin="anonymous"
      media="print"
      onload="this.media = 'all'"
    /> *@
    <!--end::Fonts-->

    <!--begin::Third Party Plugin(OverlayScrollbars)-->
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/overlayscrollbars@2.11.0/styles/overlayscrollbars.min.css"
      crossorigin="anonymous"
    />
    <!--end::Third Party Plugin(OverlayScrollbars)-->

    <!--begin::Third Party Plugin(Bootstrap Icons)-->
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css"
      crossorigin="anonymous"
    />
    <!--end::Third Party Plugin(Bootstrap Icons)-->

    <!--begin::Required Plugin(AdminLTE)-->
    <link rel="stylesheet" href="~/Admin/css/adminlte.css" />
    <!--end::Required Plugin(AdminLTE)-->

    <!-- apexcharts -->
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/apexcharts@3.37.1/dist/apexcharts.css"
      integrity="sha256-4MX+61mt9NVvvuPjUWdUdyfZfxSB1/Rf9WtqRHgG5S0="
      crossorigin="anonymous"
    />

    <!-- jsvectormap -->
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/jsvectormap@1.5.3/dist/css/jsvectormap.min.css"
      integrity="sha256-+uGLJmmTKOqBr+2E6KDYs/NRsHxSkONXFHUL0fy2O/4="
      crossorigin="anonymous"
    />

  
  </head>
  <!--end::Head-->
  <!--begin::Body-->
  <body class="layout-fixed sidebar-expand-lg bg-body-tertiary">
    <!--begin::App Wrapper-->
    <div class="app-wrapper">
      <!--begin::Header-->
      <nav class="app-header navbar navbar-expand bg-body">
        <!--begin::Container-->
        <div class="container-fluid">
          <!--begin::Start Navbar Links-->
          <ul class="navbar-nav">
            <li class="nav-item">
              <a class="nav-link" data-lte-toggle="sidebar" href="#" role="button">
                <i class="bi bi-list"></i>
              </a>
            </li>
           
          </ul>
          <!--end::Start Navbar Links-->

          <!--begin::End Navbar Links-->
          <ul class="navbar-nav ms-auto">
   
              

              <!--begin::Messages Dropdown Menu-->
@if (Context.Session.GetString("UserRole") == "Admin")
{
    <li class="nav-item dropdown">
        <a class="nav-link" data-bs-toggle="dropdown" href="#">
            <i class="bi bi-chat-text"></i>
            @if (ViewBag.UnreadCount != null && ViewBag.UnreadCount > 0)
            {
                <span class="navbar-badge badge text-bg-danger">
                    @ViewBag.UnreadCount
                </span>
            }
        </a>
        <div class="dropdown-menu dropdown-menu-lg dropdown-menu-end">

            @if (ViewBag.Messages != null && ViewBag.UnreadCount > 0)
            {
                <!-- SIRF EK UNREAD MESSAGE SHOW KARO -->
                var unreadMsg = ((IEnumerable<dynamic>)ViewBag.Messages)
                                .FirstOrDefault(m => !m.IsRead);

                if (unreadMsg != null)
                {
                    <a asp-action="Messages" asp-controller="Admin"
                       class="dropdown-item">
                        <div class="d-flex">
                            <div class="flex-shrink-0">
                                <i class="bi bi-person-circle fs-3 me-3 text-secondary"></i>
                            </div>
                            <div class="flex-grow-1">
                                <h3 class="dropdown-item-title">
                                    @unreadMsg.FirstName @unreadMsg.LastName
                                    <span class="float-end fs-7 text-danger">
                                        <i class="bi bi-circle-fill"></i>
                                    </span>
                                </h3>
                                <p class="fs-7 mb-1">@unreadMsg.Subject</p>
                                <p class="fs-7 text-secondary mb-0">
                                    <i class="bi bi-clock-fill me-1"></i>
                                    @unreadMsg.SentDate.ToString("dd MMM yyyy")
                                </p>
                            </div>
                        </div>
                    </a>
                    <div class="dropdown-divider"></div>
                }
            }
            else
            {
                <!-- KOI UNREAD MESSAGE NAHI -->
                <div class="dropdown-item text-center py-3">
                    <i class="bi bi-chat-square-text text-secondary"
                       style="font-size:28px;"></i>
                    <p class="text-secondary mb-0 mt-2"
                       style="font-size:13px;">
                        No new messages
                    </p>
                </div>
                <div class="dropdown-divider"></div>
            }

            <!-- ALL MESSAGES LINK -->
            <a asp-action="Messages" asp-controller="Admin"
               class="dropdown-item dropdown-footer text-center">
                <i class="bi bi-envelope me-1"></i>
                See All Messages
            </a>

        </div>
    </li>
}


<!--end::Messages Dropdown Menu-->

            <!--begin::Fullscreen Toggle-->
            <li class="nav-item">
              <a class="nav-link" href="#" data-lte-toggle="fullscreen">
                <i data-lte-icon="maximize" class="bi bi-arrows-fullscreen"></i>
                <i data-lte-icon="minimize" class="bi bi-fullscreen-exit" style="display: none"></i>
              </a>
            </li>
            <!--end::Fullscreen Toggle-->


<!--begin::User Menu Dropdown-->
<li class="nav-item dropdown user-menu">

    <a href="#"
       class="nav-link dropdown-toggle d-flex align-items-center"
       data-bs-toggle="dropdown"
       role="button"
       aria-expanded="false">

        <!-- Navbar Image -->
        <img src="@(Context.Session.GetString("UserImage") 
                    ?? "/images/defaults/seller.png")"
             class="user-image rounded-circle shadow"
             alt="User Image"
             style="width:35px;
                    height:35px;
                    object-fit:cover;" />

        <!-- User Name -->
        <span class="d-none d-md-inline ms-2 fw-semibold">
            @(Context.Session.GetString("UserName") ?? "User")
        </span>

    </a>

    <!-- Dropdown -->
    <ul class="dropdown-menu dropdown-menu-lg dropdown-menu-end shadow border-0">

        <!-- Header -->
        <li class="user-header bg-primary text-center p-4">

            <!-- Big Profile Image -->
            <img src="@(Context.Session.GetString("UserImage") 
                        ?? "/images/defaults/seller.png")"
                 class="rounded-circle shadow mb-3"
                 alt="User Image"
                 style="width:90px;
                        height:90px;
                        object-fit:cover;
                        border:3px solid white;" />

            <!-- Name -->
            <p class="mb-1 fw-bold text-white fs-5">
                @(Context.Session.GetString("UserName") ?? "User")
            </p>

            <!-- Role -->
            <small class="text-white">
                @(Context.Session.GetString("UserRole") ?? "Member")
            </small>

        </li>

        <!-- Footer -->
       
        <li class="user-footer d-flex justify-content-center gap-2 p-3">

    <a asp-controller="Account"
       asp-action="Profile"
       class="btn btn-outline-primary btn-sm px-3 d-flex align-items-center gap-1">

        <i class="bi bi-person"></i>
        <span>Profile</span>

    </a>

    <a asp-controller="Account"
       asp-action="Logout"
       class="btn btn-outline-danger btn-sm px-3 d-flex align-items-center gap-1">

        <i class="bi bi-box-arrow-right"></i>
        <span>Logout</span>

    </a>

  </li>
 </ul>
</li>

<!--end::User Menu Dropdown-->

          </ul>
          <!--end::End Navbar Links-->
        </div>
        <!--end::Container-->
      </nav>
      <!--end::Header-->
      <!--begin::Sidebar-->
      <aside class="app-sidebar bg-body-secondary shadow" data-bs-theme="dark">
    <!--begin::Sidebar Brand-->
        <div class="sidebar-brand">
           <!--begin::Brand Link-->
          <span class="brand-link">
            <!--begin::Brand Image-->
            <img
              src="~/Admin/assets/img/AdminLTELogo.png"
              alt="AdminLTE Logo"
              class="brand-image opacity-75 shadow"
            />
            <!--end::Brand Image-->
            <!--begin::Brand Text-->
       
@{
    var role = Context.Session.GetString("UserRole") ?? "Seller";

    var title = role == "Admin" ? "Admin Dashboard"
               : role == "Agent" ? "Agent"
               : "Seller";
}

<span class="brand-text fw-light">@title</span>

            <!--end::Brand Text-->
          </span>
          <!--end::Brand Link-->
        </div>
        <!--end::Sidebar Brand-->


        <!--begin::Sidebar Wrapper-->
        <div class="sidebar-wrapper">
    <nav class="mt-2">

        @if (Context.Session.GetString("UserRole") == "Admin")
        {
            <partial name="_AdminSidebar" />
        }
        else if (Context.Session.GetString("UserRole") == "Agent")
        {
            <partial name="_AgentSidebar" />
        }
        else
        {
            <partial name="_PrivateSellerSidebar" />
        }

    </nav>
</div>

        <!--end::Sidebar Wrapper-->
      </aside>
      <!--end::Sidebar-->

             @RenderBody()


              <!--begin::Footer-->
        <footer class="app-footer bg-white border-top py-3 mt-4">

            <div class="container-fluid d-flex flex-column flex-sm-row justify-content-between align-items-center">

                <!-- Left -->
                <div class="text-muted small mb-2 mb-sm-0">
                    © 2014–2026 <strong>Real Estate Portal</strong> | All rights reserved.
                </div>

                <!-- Right -->
                <div class="text-muted small">
                    Designed with ❤️ using AdminLTE
                </div>

            </div>

        </footer>
        <!--end::Footer-->

    </div>
    <!--end::App Wrapper-->

    <!--begin::Scripts-->

    <!-- OverlayScrollbars -->
    <script src="https://cdn.jsdelivr.net/npm/overlayscrollbars@2.11.0/browser/overlayscrollbars.browser.es6.min.js"
            crossorigin="anonymous"></script>

  <!-- Bootstrap 5 (ONLY ONCE) -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js"></script>

<!-- AdminLTE -->
<script src="~/Admin/js/adminlte.js"></script>

<!-- OverlayScrollbars -->
<script src="https://cdn.jsdelivr.net/npm/overlayscrollbars@2.11.0/browser/overlayscrollbars.browser.es6.min.js"></script>

<script>
    document.addEventListener('DOMContentLoaded', function () {

        const sidebarWrapper = document.querySelector('.sidebar-wrapper');

        if (sidebarWrapper && typeof OverlayScrollbarsGlobal !== 'undefined') {
            OverlayScrollbarsGlobal.OverlayScrollbars(sidebarWrapper, {
                scrollbars: {
                    theme: 'os-theme-light',
                    autoHide: 'leave',
                    clickScroll: true
                }
            });
        }

    });
</script>
</body>
<!--end::Body-->

</html>









