@model RealEstatePortal.Models.Package

@{
    Layout = "~/Views/Shared/_LayoutMaster.cshtml";
}

<div class="container mt-4">

    <div class="card shadow-sm border-0">
        <div class="card-header bg-primary text-white">
            <h3 class="card-title">
                <i class="bi bi-box-seam me-2"></i>
                Edit Packages
            </h3>
        </div>

        <div class="card-body">

            <form asp-action="EditPackage" method="post">

                <input type="hidden" asp-for="Id" />

                <!-- NAME -->
                <div class="mb-3">
                    <label class="form-label fw-semibold">
                        Package Name
                    </label>

                    <input asp-for="Name"
                           class="form-control" />
                </div>

                <!-- PRICE -->
                <div class="mb-3">
                    <label class="form-label fw-semibold">
                        Price
                    </label>

                    <input asp-for="Price"
                           class="form-control" />
                </div>

                <!-- LISTING LIMIT -->
                <div class="mb-3">
                    <label class="form-label fw-semibold">
                        Listing Limit
                    </label>

                    <input asp-for="ListingLimit"
                           class="form-control" />
                </div>

                <!-- DURATION -->
                <div class="mb-3">
                    <label class="form-label fw-semibold">
                        Duration Days
                    </label>

                    <input asp-for="DurationDays"
                           class="form-control" />
                </div>

                <!-- ACTIVE -->
                <div class="form-check mb-4">

                    <input asp-for="IsActive"
                           class="form-check-input" />

                    <label class="form-check-label">
                        Active Package
                    </label>

                </div>

                <!-- BUTTONS -->
                <div class="d-flex gap-2">

                    <button type="submit"
                            class="btn btn-primary">
                        <i class="bi bi-check-circle"></i>
                        Update Package
                    </button>

                    <a asp-action="Packages"
                           class="btn btn-secondary">
                        Cancel
                    </a>

                </div>

            </form>

        </div>

    </div>

</div>