@{
    Layout = "~/Views/Shared/_LayoutMaster.cshtml";
}

<div class="container-fluid mt-3">
    <div class="row mt-2">

        <div class="col-md-4">
            <div class="card text-center shadow-sm">
                <div class="card-body">
                    <h6>Revenue</h6>
                    <h4 class="text-success">$12,450</h4>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card text-center shadow-sm">
                <div class="card-body">
                    <h6>Visits</h6>
                    <h4 class="text-primary">320</h4>
                </div>
            </div>
        </div>

        
        <!-- MESSAGES -->
        <div class="col-md-4">
            <div class="card text-center shadow-sm">
                <div class="card-body">
                    <h6>Messages</h6>
                    <h4 class="text-warning">@ViewBag.TotalMessages</h4>
                </div>
            </div>
        </div>



    </div>
    <div class="row g-3 mt-2">

        <!-- TOTAL LISTINGS -->
        <div class="col-md-3">
            <div class="card shadow-sm">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-muted mb-1">Total Listings</h6>
                        <h4 class="mb-0 text-primary">@ViewBag.Total</h4>
                    </div>
                    <i class="bi bi-house-door fs-3 text-primary"></i>
                </div>
            </div>
        </div>

        <!-- APPROVED -->
        <div class="col-md-3">
            <div class="card shadow-sm">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-muted mb-1">Approved</h6>
                        <h4 class="mb-0 text-success">@ViewBag.Approved</h4>
                    </div>
                    <i class="bi bi-check-circle fs-3 text-success"></i>
                </div>
            </div>
        </div>

        <!-- PENDING -->
        <div class="col-md-3">
            <div class="card shadow-sm">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-muted mb-1">Pending</h6>
                        <h4 class="mb-0 text-warning">@ViewBag.Pending</h4>
                    </div>
                    <i class="bi bi-hourglass-split fs-3 text-warning"></i>
                </div>
            </div>
        </div>

        <!-- USERS -->
        <div class="col-md-3">
            <div class="card shadow-sm">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-muted mb-1">Users</h6>
                        <h4 class="mb-0 text-info">@ViewBag.Users</h4>
                    </div>
                    <i class="bi bi-people fs-3 text-info"></i>
                </div>
            </div>
        </div>
        
    </div>



</div>

