
@model List<RealEstatePortal.Models.User>

@{
    Layout = "~/Views/Shared/_LayoutMaster.cshtml";
}

<div class="container-fluid mt-3">

    <div class="card shadow-sm">

        <!-- HEADER -->
        <div class="card-header bg-primary text-white">
            <h3 class="card-title">
                <i class="bi bi-people-fill me-2"></i> Manage Users
            </h3>
        </div>

        <!-- SEARCH BAR -->
        <div class="card-body border-bottom">

            <form method="get" asp-action="Users" asp-controller="Admin">

                <div class="row g-2 align-items-end">

                    <!-- NAME -->
                    <div class="col-md-3">
                        <label class="form-label small text-muted">Name</label>

                        <input type="text"
                               name="keyword"
                               value="@ViewBag.Keyword"
                               class="form-control form-control-sm"
                               placeholder="Search name..." />
                    </div>

                    <!-- EMAIL -->
                    <div class="col-md-3">
                        <label class="form-label small text-muted">Email</label>

                        <input type="text"
                               name="email"
                               value="@ViewBag.Email"
                               class="form-control form-control-sm"
                               placeholder="Search email..." />
                    </div>

                    <!-- ROLE -->
                    <div class="col-md-2">
                        <label class="form-label small text-muted">Role</label>

                        <select name="role" class="form-select form-select-sm">

                            <option value="">All Roles</option>

                            <option value="Agent"
                                    selected="@(ViewBag.Role == "Agent")">
                                Agent
                            </option>

                            <option value="PrivateSeller"
                                    selected="@(ViewBag.Role == "PrivateSeller")">
                                Private Seller
                            </option>

                        </select>
                    </div>

                    <!-- STATUS -->
                    <div class="col-md-2">
                        <label class="form-label small text-muted">Status</label>

                        <select name="status" class="form-select form-select-sm">

                            <option value="">All Status</option>

                            <option value="Active"
                                    selected="@(ViewBag.Status == "Active")">
                                Active
                            </option>

                            <option value="Blocked"
                                    selected="@(ViewBag.Status == "Blocked")">
                                Blocked
                            </option>

                        </select>
                    </div>

                    <!-- BUTTONS -->
                    <div class="col-md-2 d-flex gap-2">

                        <button type="submit"
                                class="btn btn-primary btn-sm">

                            <i class="bi bi-search"></i> Search
                        </button>

                        <a asp-action="Users"
                               class="btn btn-outline-secondary btn-sm">

                            <i class="bi bi-x-circle"></i> Clear
                        </a>

                    </div>

                </div>

            </form>

        </div>

        <!-- RESULTS -->
        <div class="px-3 pt-2">
            <small class="text-muted">
                Showing @Model.Count user(s)
            </small>
        </div>

        <!-- TABLE -->
        <div class="card-body table-responsive p-0">

            <table class="table table-hover text-nowrap mb-0">

                <thead class="table-light">
                    <tr>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Role</th>
                        <th>Status</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>

                <tbody>

                    @if (Model.Count == 0)
                    {
                        <tr>
                            <td colspan="5"
                                class="text-center text-muted py-4">

                                No users found

                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            <tr>

                                <!-- NAME -->
                                <td class="fw-semibold">
                                    @item.Name
                                </td>

                                <!-- EMAIL -->
                                <td>
                                    @item.Email
                                </td>

                                <!-- ROLE -->
                                <td>
                                    @if (item.Role == "Agent")
                                    {
                                        <span class="badge bg-primary">
                                            Agent
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-primary">
                                            Private Seller
                                        </span>
                                    }
                                </td>

                                <!-- STATUS -->
                                <td>

                                    @if (item.Status == "Blocked")
                                    {
                                        <span class="badge bg-danger">
                                            Blocked
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">
                                            Active
                                        </span>
                                    }

                                </td>

                               
                                <!-- ACTIONS -->
                                <td class="text-center">

                                    <!-- ASSIGN PACKAGE -->
                                    <a asp-action="AssignPackage"
                                           asp-route-id="@item.Id"
                                           class="btn btn-outline-primary btn-sm me-1">

                                        <i class="bi bi-box-seam"></i>
                                        Package
                                    </a>

                                    @if (item.Status == "Blocked")
                                    {
                                        <form asp-action="UnblockUser"
                                              method="post"
                                              style="display:inline;">

                                            <input type="hidden"
                                                   name="id"
                                                   value="@item.Id" />

                                            <button type="submit"
                                                    class="btn btn-success btn-sm">

                                                <i class="bi bi-unlock"></i>
                                                Unblock

                                            </button>

                                        </form>
                                    }
                                    else
                                    {
                                        <form asp-action="DeleteUser"
                                              method="post"
                                              style="display:inline;">

                                            <input type="hidden"
                                                   name="id"
                                                   value="@item.Id" />


                                            <button type="submit"
                                                    class="btn btn-danger btn-sm"
                                                    onclick="return confirm('Block this user?')">

                                                <i class="bi bi-lock"></i>
                                                Block

                                            </button>

                                        </form>
                                    }

                                </td>

                            </tr>
                        }
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>