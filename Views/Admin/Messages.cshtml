@model List<RealEstatePortal.Models.ContactMessage>
@{
    Layout = "~/Views/Shared/_LayoutMaster.cshtml";
}

<div class="container-fluid mt-3">
    <div class="card shadow-sm">

        <div class="card-header bg-primary text-white">
            <h3 class="card-title">
                <i class="bi bi-chat-text me-2"></i> Contact Messages
            </h3>
        </div>

        <div class="card-body table-responsive p-0">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Subject</th>
                        <th>Message</th>
                        <th>Date</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Count == 0)
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted py-4">
                                No messages yet
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var msg in Model)
                        {
                            <tr class="@(!msg.IsRead ? "table-warning" : "")">
                                <td>@msg.FirstName @msg.LastName</td>
                                <td>@msg.Email</td>
                                <td>@msg.Subject</td>
                                <td>@msg.Message</td>
                                <td>@msg.SentDate.ToString("dd MMM yyyy")</td>
                                <td>
                                    @if (msg.IsRead)
                                    {
                                        <span class="badge bg-success">Read</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">Unread</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

    </div>
</div>