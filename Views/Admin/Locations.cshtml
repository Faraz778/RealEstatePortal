@model List<RealEstatePortal.Models.City>

@{
    Layout = "~/Views/Shared/_LayoutMaster.cshtml";
}

<div class="container-fluid mt-3">

    <div class="card shadow-sm">

        <!-- HEADER -->
        <div class="card-header bg-primary text-white">
            <h3 class="card-title">
                <i class="bi bi-geo-alt me-2"></i> Manage Cities
            </h3>
        </div>

        <!-- ADD CITY -->
        <div class="card-body border-bottom">

            <form method="post" asp-action="AddCity" class="row g-2">

                <div class="col-md-6">
                    <input type="text" name="Name" class="form-control"
                           placeholder="Enter city name" required />
                </div>

                <div class="col-md-2">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="bi bi-plus-circle me-1"></i> Add
                    </button>
                </div>

            </form>

        </div>

        <!-- TABLE -->
        <div class="card-body table-responsive p-0">

            <table class="table table-hover text-nowrap mb-0">
                <thead class="table-light">
                    <tr>
                        <th>ID</th>
                        <th>City Name</th>
                        <th class="text-center">Action</th>
                    </tr>
                </thead>

              
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Id</td>

                            <td class="fw-semibold">
                                @item.Name
                            </td>

                            <td class="text-center">

                                <div class="d-flex justify-content-center align-items-center gap-2">

                                    <!-- EDIT -->
                                    <a href="/Admin/EditCity/@item.Id"
                                           class="btn btn-sm btn-outline-primary d-flex align-items-center">

                                        <i class="bi bi-pencil-square me-1"></i>
                                        Edit

                                    </a>

                                    <!-- DELETE -->
                                    <a href="/Admin/DeleteCity/@item.Id"
                                           class="btn btn-sm btn-outline-danger d-flex align-items-center"
                                           onclick="return confirm('Delete this city?');">

                                        <i class="bi bi-trash me-1"></i>
                                        Delete
                                    </a>

                                </div>

                            </td>
                        </tr>
                    }
                </tbody>
            </table>

        </div>

    </div>

</div>