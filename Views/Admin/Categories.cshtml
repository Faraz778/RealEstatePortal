@model List<RealEstatePortal.Models.Category>

@{
    Layout = "~/Views/Shared/_LayoutMaster.cshtml";
}

<div class="container-fluid mt-3">

    <!-- CATEGORY CARD -->
    <div class="card shadow-sm mb-4 border-0">

        <!-- Header -->
        <div class="card-header bg-primary text-white">
            <h3 class="card-title mb-0">
                <i class="bi bi-plus-circle me-2"></i> Add New Category
            </h3>
        </div>

        <div class="card-body">

            <form method="post" asp-action="AddCategory">

                <div class="mb-3">
                    <label class="form-label fw-semibold">
                        Category Name
                    </label>

                    <input type="text"
                           name="Name"
                           class="form-control"
                           placeholder="Enter category name" />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">
                        Description
                    </label>

                    <textarea name="Description"
                              class="form-control"
                              rows="3"
                              placeholder="Enter description"></textarea>
                </div>

                <button type="submit" class="btn btn-success px-4">
                    <i class="bi bi-check-circle me-1"></i>
                    Add Category
                </button>

            </form>

        </div>
    </div>

    <!-- CATEGORY LIST CARD -->
    <div class="card shadow-sm border-0">

        <!-- Header -->
        <div class="card-header bg-dark text-white">
            <h3 class="card-title mb-0">
                <i class="bi bi-list-ul me-2"></i> Category List
            </h3>
        </div>

        <div class="card-body p-0">

            <div class="table-responsive">

                <table class="table table-hover table-bordered align-middle mb-0">

                    <thead class="table-light">

                        <tr>
                            <th>ID</th>
                            <th>Name</th>
                            <th>Description</th>
                            <th>Status</th>
                            <th style="width:260px;">
                                Actions
                            </th>
                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var item in Model)
                        {
                            <tr>

                                <td>@item.Id</td>

                                <td class="fw-semibold">
                                    @item.Name
                                </td>

                                <td>
                                    @item.Description
                                </td>

                                <td>

                                    @if (item.IsActive)
                                    {
                                        <span class="badge bg-success px-3 py-2">
                                            Active
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger px-3 py-2">
                                            Inactive
                                        </span>
                                    }

                                </td>

                              
                                <td>
                                    <div class="d-flex gap-2 align-items-center">

                                        <!-- EDIT -->
                                        <a href="/Admin/EditCategory/@item.Id"
                                               class="btn btn-sm btn-outline-primary d-flex align-items-center"
                                               title="Edit">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>


                                        <!-- DELETE -->
                                        <a href="/Admin/DeleteCategory/@item.Id"
                                               class="btn btn-sm btn-outline-danger d-flex align-items-center"
                                               title="Delete"
                                               onclick="return confirm('Delete this category?')">
                                            <i class="bi bi-trash"></i>
                                        </a>

                                        <!-- ACTIVATE / DEACTIVATE -->
                                        @if (item.IsActive)
                                        {
                                            <a href="/Admin/DeactivateCategory/@item.Id"
                                                   class="btn btn-sm btn-outline-warning d-flex align-items-center">
                                                <i class="bi bi-eye-slash me-1"></i>
                                                Deactivate
                                            </a>
                                        }
                                        else
                                        {
                                            <a href="/Admin/ActivateCategory/@item.Id"
                                                   class="btn btn-sm btn-outline-success d-flex align-items-center">
                                                <i class="bi bi-check-circle me-1"></i>
                                                Activate
                                            </a>
                                        }

                                    </div>
                                </td>


                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>