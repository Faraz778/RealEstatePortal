@{
    Layout = "~/Views/Shared/_LayoutHome.cshtml";
    ViewData["Title"] = "About Us";
}

<style>
    .about-card {
        background: #fff;
        border-radius: 8px;
        padding: 30px 20px;
        text-align: center;
        box-shadow: 0 2px 12px rgba(0,0,0,0.08);
        height: 100%;
    }
    .about-card i {
        font-size: 36px;
        color: #f0c228;
        margin-bottom: 15px;
    }
    .about-card h4 {
        color: #1a1a2e;
        font-weight: 700;
        margin-bottom: 10px;
    }
    .why-item i {
        font-size: 20px;
        margin-right: 8px;
        margin-top: 3px;
    }
    .cta-box {
        background: linear-gradient(135deg, #1a1a2e, #2d2d44);
        border-radius: 12px;
        padding: 50px 30px;
        text-align: center;
        margin-bottom: 40px;
    }
</style>

<!-- PAGE HEADER -->
<div class="page-head">
    <div class="container">
        <div class="row">
            <div class="page-head-content">
                <h1 class="page-title">About Us</h1>
            </div>
        </div>
    </div>
</div>

<!-- INTRO SECTION -->
<div class="content-area padding-top-40" style="background-color:#fff;">
    <div class="container" style="padding-top:40px; padding-bottom:40px;">

        <!-- INTRO ROW -->
        <div class="row" style="margin-bottom:40px;">

            <!-- LEFT TEXT -->
            <div class="col-md-6">
                <h2 style="color:#1a1a2e; font-weight:700; margin-bottom:15px;">
                    Welcome to <span style="color:#f0c228;">Realtors Portal</span>
                </h2>
                <p style="font-size:16px; color:#6c757d; margin-bottom:15px;">
                    An online real estate platform that connects buyers, sellers,
                    tenants, and agents — all in one place.
                </p>
                <p style="color:#6c757d;">
                    We believe finding the right property should be simple, fast,
                    and stress-free. Whether you're looking to buy, sell, or rent —
                    we've got you covered with thousands of verified listings across
                    the country.
                </p>

                <!-- STATS -->
                <div class="row text-center" style="margin-top:30px;">
                    <div class="col-xs-4">
                        <h3 style="color:#f0c228; font-weight:700; margin-bottom:5px;">500+</h3>
                        <small style="color:#6c757d;">Properties Listed</small>
                    </div>
                    <div class="col-xs-4" style="border-left:1px solid #dee2e6; border-right:1px solid #dee2e6;">
                        <h3 style="color:#f0c228; font-weight:700; margin-bottom:5px;">200+</h3>
                        <small style="color:#6c757d;">Verified Agents</small>
                    </div>
                    <div class="col-xs-4">
                        <h3 style="color:#f0c228; font-weight:700; margin-bottom:5px;">1000+</h3>
                        <small style="color:#6c757d;">Happy Clients</small>
                    </div>
                </div>

            </div>

            <!-- RIGHT IMAGE -->
            <div class="col-md-6 text-center">
                <img src="https://cdnjs.cloudflare.com/ajax/libs/twemoji/14.0.2/svg/1f3e0.svg"
                     alt="Real Estate"
                     style="width:280px; opacity:0.85; margin-top:20px;" />
            </div>

        </div>

        <hr />

        <div class="row" style="margin-top:40px; margin-bottom:40px;">

            <div class="col-md-4" style="margin-bottom:20px;">
                <div class="about-card">
                    <i class="fa fa-eye"></i>
                    <h4>Our Vision</h4>
                    <p style="color:#6c757d;">
                        To become the leading digital real estate platform,
                        making property transactions transparent and accessible
                        for everyone.
                    </p>
                </div>
            </div>

            <div class="col-md-4" style="margin-bottom:20px;">
                <div class="about-card">
                    <i class="fa fa-bullseye"></i>
                    <h4>Our Mission</h4>
                    <p style="color:#6c757d;">
                        Helping people find their perfect property quickly
                        and easily by connecting them with trusted agents
                        and verified listings.
                    </p>
                </div>
            </div>

            <div class="col-md-4" style="margin-bottom:20px;">
                <div class="about-card">
                    <i class="fa fa-shield"></i>
                    <h4>Our Values</h4>
                    <p style="color:#6c757d;">
                        Trust, transparency, and customer satisfaction are
                        at the core of everything we do. We put our users
                        first, always.
                    </p>
                </div>
            </div>

        </div>

        <hr />

        <!-- WHY CHOOSE US -->
        <div style="margin-top:40px; margin-bottom:40px;">

            <div class="text-center" style="margin-bottom:30px;">
                <h2 style="color:#1a1a2e; font-weight:700;">Why Choose Us?</h2>
                <p style="color:#6c757d;">We make real estate simple for everyone</p>
                <div style="width:60px; height:4px; background:#f0c228; margin:0 auto; border-radius:2px;"></div>
            </div>

            <div class="row">

                <div class="col-md-3 col-sm-6" style="margin-bottom:20px;">
                    <div class="why-item" style="display:flex; align-items:flex-start;">
                        <i class="fa fa-check-circle why-item"></i>
                        <div>
                            <h6 style="font-weight:700; margin-bottom:5px;">Verified Listings</h6>
                            <p style="color:#6c757d; font-size:13px;">All properties are reviewed before going live.</p>
                        </div>
                    </div>
                </div>

                <div class="col-md-3 col-sm-6" style="margin-bottom:20px;">
                    <div style="display:flex; align-items:flex-start;">
                        <i class="fa fa-search why-item"></i>
                        <div>
                            <h6 style="font-weight:700; margin-bottom:5px;">Easy Search</h6>
                            <p style="color:#6c757d; font-size:13px;">Find properties by city, category, and price.</p>
                        </div>
                    </div>
                </div>

                <div class="col-md-3 col-sm-6" style="margin-bottom:20px;">
                    <div style="display:flex; align-items:flex-start;">
                        <i class="fa fa-users why-item"></i>
                        <div>
                            <h6 style="font-weight:700; margin-bottom:5px;">Trusted Agents</h6>
                            <p style="color:#6c757d; font-size:13px;">Connect with professional real estate agents.</p>
                        </div>
                    </div>
                </div>

                <div class="col-md-3 col-sm-6" style="margin-bottom:20px;">
                    <div style="display:flex; align-items:flex-start;">
                        <i class="fa fa-phone why-item"></i>
                        <div>
                            <h6 style="font-weight:700; margin-bottom:5px;">24/7 Support</h6>
                            <p style="color:#6c757d; font-size:13px;">Our team is always here to help you.</p>
                        </div>
                    </div>
                </div>

            </div>
        </div>

        <!-- CALL TO ACTION -->
        <div class="cta-box">
            <h2 style="color:#fff; font-weight:700; margin-bottom:15px;">
                Ready to Find Your Dream Property?
            </h2>
            <p style="color:rgba(255,255,255,0.75); margin-bottom:25px;">
                Browse thousands of listings or list your property today.
            </p>
            <a href="/Home/Search"
               style="background:#f0c228; color:#1a1a2e; font-weight:700;
                      padding:10px 25px; border-radius:5px;
                      text-decoration:none; margin-right:10px;">
                <i class="fa fa-search"></i> Browse Properties
            </a>
            <a href="/Account/Login"
               style="border:2px solid #fff; color:#fff; font-weight:700;
                      padding:10px 25px; border-radius:5px; text-decoration:none;">
                <i class="fa fa-user-plus"></i> Join Now
            </a>
        </div>

    </div>
</div>