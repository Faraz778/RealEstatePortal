@model List<RealEstatePortal.Models.Listing>

@{
    Layout = "~/Views/Shared/_LayoutHome.cshtml";
}

<style>
    .search-card {
        background: #fff;
        border-radius: 10px;
        overflow: hidden;
        box-shadow: 0 2px 12px rgba(0,0,0,0.08);
        margin-bottom: 25px;
        transition: 0.3s;
    }

        .search-card:hover {
            box-shadow: 0 5px 20px rgba(0,0,0,0.15);
            transform: translateY(-3px);
        }

        .search-card img {
            width: 100%;
            height: 200px;
            object-fit: cover;
        }

    .card-content {
        padding: 15px 20px;
    }

        .card-content h5 {
            color: #1a1a2e;
            font-weight: 700;
            margin-bottom: 5px;
            font-size: 16px;
        }

    .card-price {
        color: #f0c228;
        font-weight: 700;
        font-size: 16px;
        margin-bottom: 8px;
    }

    .card-desc {
        color: #888;
        font-size: 13px;
        line-height: 1.6;
        margin-bottom: 10px;
    }

    .card-meta {
        font-size: 13px;
        color: #666;
        margin-bottom: 10px;
    }

        .card-meta i {
            color: #f0c228;
            margin-right: 4px;
        }

    .view-btn {
        display: block;
        text-align: center;
        background: #1a1a2e;
        color: #fff;
        padding: 10px;
        border-radius: 0 0 10px 10px;
        font-weight: 600;
        font-size: 14px;
        text-decoration: none;
        transition: 0.3s;
    }

        .view-btn:hover {
            background: #f0c228;
            color: #1a1a2e;
            text-decoration: none;
        }

    .no-image-box {
        height: 200px;
        background: #f8f8f8;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .search-bar-wrap {
        background: #fff;
        border-radius: 10px;
        padding: 20px 25px;
        box-shadow: 0 2px 12px rgba(0,0,0,0.06);
        margin-bottom: 30px;
    }

    .search-input {
        height: 45px;
        border-radius: 8px;
        border: 1px solid #ddd;
        padding: 0 15px;
        font-size: 15px;
        width: 100%;
        outline: none;
    }

        .search-input:focus {
            border-color: #f0c228;
        }

    .search-btn {
        height: 45px;
        background: #f0c228;
        color: #1a1a2e;
        border: none;
        border-radius: 8px;
        font-weight: 600;
        padding: 0 25px;
        cursor: pointer;
        width: 100%;
    }

        .search-btn:hover {
            background: #d4a800;
        }

    .results-count {
        color: #888;
        font-size: 14px;
        margin-bottom: 20px;
    }
</style>

<!-- PAGE HEADER -->
<div class="page-head">
    <div class="container">
        <div class="row">
            <div class="page-head-content">
                <h1 class="page-title">Search Properties</h1>
            </div>
        </div>
    </div>
</div>

<div class="content-area padding-top-40" style="background:#f4f6f9;">
    <div class="container" style="padding-top:30px; padding-bottom:50px;">

        <!-- SEARCH BAR -->
        <div class="search-bar-wrap">
            <form method="get" asp-action="Search" asp-controller="Home">
                <div class="row">

                    <div class="col-md-10" style="margin-bottom:10px;">
                        <input type="text"
                               name="keyword"
                               class="search-input"
                               placeholder="Search by title or description..."
                               value="@ViewBag.Keyword" />
                    </div>

                    <div class="col-md-2" style="margin-bottom:10px;">
                        <button type="submit" class="search-btn">
                            <i class="fa fa-search"></i> Search
                        </button>
                    </div>

                </div>
            </form>
        </div>

        <!-- RESULTS COUNT -->
        <p class="results-count">
            <i class="fa fa-home" style="color:#f0c228;"></i>
            Showing <strong>@Model.Count</strong> propert@(Model.Count == 1 ? "y" : "ies") found
        </p>

        <!-- NO RESULTS -->
        @if (!Model.Any())
        {
            <div style="text-align:center; padding:60px 0;">
                <i class="fa fa-search"
                   style="font-size:50px; color:#ddd; display:block; margin-bottom:15px;"></i>
                <h4 style="color:#aaa;">No properties found</h4>
                <p style="color:#bbb;">Try a different keyword</p>
                <a href="/Home/Search"
                       style="background:#f0c228; color:#1a1a2e; font-weight:600;
                    padding:10px 30px; border-radius:50px; text-decoration:none;">
                    View All Properties
                </a>
            </div>
        }
        else
        {
            <div class="row">
                @foreach (var item in Model)
                {
                    <div class="col-md-4 col-sm-6">
                        <div class="search-card">

                            <!-- IMAGE -->
                            @if (item.Images != null && item.Images.Any())
                            {
                                <img src="@item.Images.First().ImagePath" alt="@item.Title" />
                            }
                            else
                            {
                                <div class="no-image-box">
                                    <span style="color:#ccc; text-align:center;">
                                        <i class="fa fa-picture-o"
                                           style="font-size:35px; display:block; margin-bottom:8px;"></i>
                                        No Image
                                    </span>
                                </div>
                            }

                            <!-- CONTENT -->
                            <div class="card-content">

                                <!-- TITLE -->
                                <h5>@item.Title</h5>

                                <!-- PRICE -->
                                <div class="card-price">
                                    <i class="fa fa-tag"></i>
                                    PKR @item.Price.ToString("N0")
                                </div>

                                <!-- META -->
                                <div class="card-meta">
                                    <i class="fa fa-th-large"></i> @item.Category
                                    &nbsp;&nbsp;
                                    <i class="fa fa-map-marker"></i> @item.Location
                                </div>

                                <!-- DESCRIPTION -->
                                <p class="card-desc">
                                    @(item.Description != null && item.Description.Length > 70
                                        ? item.Description.Substring(0, 70) + "..."
                                        : item.Description)
                                </p>

                            </div>

                            <!-- VIEW BUTTON -->
                            <a asp-controller="Home"
                                   asp-action="Details"
                                   asp-route-id="@item.Id"
                                   class="view-btn">
                                <i class="fa fa-eye"></i> View Details
                            </a>

                        </div>
                    </div>
                }
            </div>
        }

    </div>
</div>