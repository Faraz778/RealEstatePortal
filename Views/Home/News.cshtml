@{
    Layout = "~/Views/Shared/_LayoutHome.cshtml";
     ViewData["Title"] = "News";
}

<style>
    .news-card {
        background: #fff;
        border-radius: 8px;
        box-shadow: 0 2px 12px rgba(0,0,0,0.08);
        margin-bottom: 25px;
        overflow: hidden;
    }
    .news-card img {
        width: 100%;
        height: 200px;
        object-fit: cover;
    }
    .news-card-body {
        padding: 20px;
    }
    .news-card-body h5 {
        color: #1a1a2e;
        font-weight: 700;
        margin-bottom: 10px;
    }
    .news-card-body p {
        color: #6c757d;
        font-size: 14px;
        margin-bottom: 0;
    }
    .news-date {
        font-size: 12px;
        color: #f0c228;
        font-weight: 600;
        margin-bottom: 8px;
    }
</style>

<!-- PAGE HEADER -->
<div class="page-head">
    <div class="container">
        <div class="row">
            <div class="page-head-content">
                <h1 class="page-title">News page</h1>
            </div>
        </div>
    </div>
</div>

<!-- NEWS SECTION -->
<div class="content-area padding-top-40" style="background-color:#fff;">
    <div class="container" style="padding-top:40px; padding-bottom:40px;">

        <!-- TITLE -->
        <div class="text-center" style="margin-bottom:40px;">
            <h2 style="color:#1a1a2e; font-weight:700;">
                Latest Real Estate <span style="color:#f0c228;">News</span>
            </h2>
            <p style="color:#6c757d;">Stay updated with the latest trends in real estate</p>
            <div style="width:60px; height:4px; background:#f0c228; margin:0 auto; border-radius:2px;"></div>
        </div>

        <!-- ROW 1 -->
        <div class="row">

            <div class="col-md-4">
                <div class="news-card">
                    <img src="~/Home/assets/img/demo/property-1.jpg" alt="News 1" />
                    <div class="news-card-body">
                        <p class="news-date"><i class="fa fa-calendar"></i> May 10, 2026</p>
                        <h5>Property Prices Rising in Major Cities</h5>
                        <p>Experts predict continued growth in the real estate market as demand increases.</p>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="news-card">
                    <img src="~/Home/assets/img/demo/property-2.jpg" alt="News 2" />
                    <div class="news-card-body">
                        <p class="news-date"><i class="fa fa-calendar"></i> May 08, 2026</p>
                        <h5>Tips for First-Time Home Buyers</h5>
                        <p>Learn the important factors to consider before buying your first property.</p>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="news-card">
                    <img src="~/Home/assets/img/demo/property-3.jpg" alt="News 3" />
                    <div class="news-card-body">
                        <p class="news-date"><i class="fa fa-calendar"></i> May 05, 2026</p>
                        <h5>How to Choose the Right Real Estate Agent</h5>
                        <p>Finding a trusted agent is key to a successful property deal.</p>
                    </div>
                </div>
            </div>

        </div>

        <!-- ROW 2 -->
        <div class="row">

            <div class="col-md-4">
                <div class="news-card">
                    <img src="~/Home/assets/img/demo/property-4.jpg" alt="News 4" />
                    <div class="news-card-body">
                        <p class="news-date"><i class="fa fa-calendar"></i> May 03, 2026</p>
                        <h5>Renting vs Buying: What's Better in 2026?</h5>
                        <p>With rising prices, many are wondering whether renting or buying makes more sense.</p>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="news-card">
                    <img src="~/Home/assets/img/demo/property-5.jpg" alt="News 5" />
                    <div class="news-card-body">
                        <p class="news-date"><i class="fa fa-calendar"></i> May 01, 2026</p>
                        <h5>Top 5 Locations for Property Investment</h5>
                        <p>Discover the best cities and areas for real estate investment this year.</p>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="news-card">
                    <img src="~/Home/assets/img/demo/property-6.jpg" alt="News 6" />
                    <div class="news-card-body">
                        <p class="news-date"><i class="fa fa-calendar"></i> Apr 28, 2026</p>
                        <h5>Commercial Real Estate Trends to Watch</h5>
                        <p>Office spaces and commercial properties are seeing major shifts this year.</p>
                    </div>
                </div>
            </div>

        </div>

    </div>
</div>