@model List<RealEstatePortal.Models.Listing>

@{
    Layout = "~/Views/Shared/_LayoutHome.cshtml";
}

<div class="slider-area">

    <!-- SLIDER -->
    <div class="slider">
        <div id="bg-slider" class="owl-carousel owl-theme">

            <div class="item">
                <img src="~/Home/assets/img/slide1/slider-image-2.jpg" alt="">
                </div>

                <div class="item">
                    <img src="~/Home/assets/img/slide1/slider-image-4.jpg" alt="">
                    </div>

                    <div class="item">
                        <img src="~/Home/assets/img/slide1/slider-image-1.jpg" alt="">
                        </div>

                    </div>
                </div>

                <!-- SLIDER CONTENT -->
                <div class="slider-content">

                    <div class="row">

                        <div class="col-lg-8 col-lg-offset-2 col-md-10 col-md-offset-1 col-sm-12">

                            <h2>Property Searching Just Got So Easy</h2>

                            <p>
                                Find your perfect home, apartment, or commercial space with ease.
                            </p>

                            <!-- SEARCH FORM -->
                            <div class="search-form wow pulse" data-wow-delay="0.8s">

                                <form asp-controller="Home"
                                      asp-action="Search"
                                      method="get"
                                      class="form-inline">

                                    <button class="btn toggle-btn" type="button">
                                        <i class="fa fa-bars"></i>
                                    </button>

                                    <!-- KEYWORD -->
                                    <div class="form-group">
                                        <input type="text"
                                               name="keyword"
                                               class="form-control"
                                               placeholder="Search properties...">
                                    </div>

                                    <!-- CITY -->
                                    <div class="form-group">

                                        <select name="cityId"
                                                class="selectpicker"
                                                title="Select your city">

                                            @if (ViewBag.Cities != null)
                                            {
                                                foreach (var city in ViewBag.Cities)
                                                {
                                                    <option value="@city.Id">
                                                        @city.Name
                                                    </option>
                                                }
                                            }

                                        </select>

                                    </div>

                                    <!-- CATEGORY -->
                                    <div class="form-group">

                                        <select name="category"
                                                class="selectpicker"
                                                title="Select category">

                                            <option value="">All Categories</option>

                                            @foreach (var cat in ViewBag.Categories)
                                            {
                                                <option value="@cat.Name">
                                                    @cat.Name
                                                </option>
                                            }

                                        </select>

                                    </div>

                                    <!-- PURPOSE -->
                                    <div class="form-group">
                                        <select name="purpose"
                                                class="selectpicker"
                                                title="Purpose">

                                            <option value="">Buy / Rent</option>
                                            <option value="Sell">Buy</option>
                                            <option value="Rent">Rent</option>

                                        </select>
                                    </div>

                                    <!-- SELLER TYPE -->
                                    <div class="form-group">
                                        <select name="sellerType"
                                                class="selectpicker"
                                                title="Seller Type">
                                            <option value="">All Sellers</option>
                                            <option value="Agent">Agent</option>
                                            <option value="PrivateSeller">Private Seller</option>
                                        </select>
                                    </div>

                                    <!-- SEARCH BUTTON -->
                                    <button class="btn search-btn" type="submit">
                                        <i class="fa fa-search"></i>
                                    </button>

                                </form>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

            <!-- PROPERTY AREA -->
            @if (Model != null && Model.Count > 0)
            {
                <div class="content-area home-area-1 recent-property"
                     style="background-color:#FCFCFC;padding-bottom:55px;">

                    <div class="container">

                        <!-- TITLE -->
                        <div class="row">

                            <div class="col-md-10 col-md-offset-1 col-sm-12 text-center page-title">

                                <h2>Top Submitted Property</h2>

                                <p>
                                    Find the best properties submitted by users.
                                </p>

                            </div>

                        </div>

                        <!-- PROPERTY GRID -->
                        <div class="row">

                            <div class="proerty-th">

                                @foreach (var item in Model)
                                {
                                    <div class="col-sm-6 col-md-3">

                                        <div class="box-two proerty-item">

                                            <!-- IMAGE -->
                                            <div class="item-thumb">

                                                @if (item.Images != null && item.Images.Any())
                                                {
                                                    <img src="@item.Images.First().ImagePath"
                                                         style="height:200px;width:100%;object-fit:cover;" />
                                                }
                                                else
                                                {
                                                    <div style="height:200px;
                                                        background:#f8f8f8;
                                                        text-align:center;
                                                        line-height:200px;">

                                                        <span>No Image</span>

                                                    </div>
                                                }

                                            </div>

                                            <!-- CONTENT -->
                                            <div class="item-entry" style="padding:15px;">

                                                <h5 style="font-weight:bold;">
                                                    @item.Title
                                                </h5>

                                                <div class="dot-hr"></div>

                                                <!-- PRICE -->
                                                <div class="proerty-price"
                                                     style="margin:10px 0;font-weight:bold;">

                                                    Rs @item.Price.ToString("N0")

                                                </div>

                                                <!-- CITY -->
                                                <div>

                                                    <i class="fa fa-map-marker"></i>

                                                    @(item.City?.Name ?? "N/A")

                                                </div>

                                            </div>

                                        </div>

                                    </div>
                                }

                            </div>

                        </div>

                        <!-- BUTTON -->
                        <div class="text-center" style="margin-top:20px;">

                            <a href="/Home/Search"
                                   class="btn border-btn more-black">

                                All Properties

                            </a>

                        </div>

                    </div>

                </div>
            }


            <!-- WELCOME AREA -->
            <div class="Welcome-area">

                <div class="container">

                    <div class="row">

                        <div class="col-md-12 Welcome-entry col-sm-12">

                            <!-- LEFT -->
                            <div class="col-md-5 col-md-offset-2 col-sm-6 col-xs-12">

                                <div class="welcome_text wow fadeInLeft"
                                     data-wow-delay="0.3s">

                                    <div class="row">

                                        <div class="col-md-10 col-md-offset-1
                                            col-sm-12 text-center page-title">
                                            <h2>GARO ESTATE</h2>
                                        </div>

                                    </div>

                                </div>

                            </div>

                            <!-- RIGHT -->
                            <div class="col-md-5 col-sm-6 col-xs-12">

                                <div class="welcome_services wow fadeInRight"
                                     data-wow-delay="0.3s">

                                    <div class="row">

                                        <div class="col-xs-6 m-padding">

                                            <div class="welcome-estate">

                                                <div class="welcome-icon">
                                                    <i class="pe-7s-home pe-4x"></i>
                                                </div>
                                                <h3>Any Property</h3>
                                            </div>

                                        </div>

                                        <div class="col-xs-6 m-padding">

                                            <div class="welcome-estate">

                                                <div class="welcome-icon">
                                                    <i class="pe-7s-users pe-4x"></i>
                                                </div>

                                                <h3>More Clients</h3>

                                            </div>

                                        </div>

                                        <div class="col-xs-6 m-padding">

                                            <div class="welcome-estate">

                                                <div class="welcome-icon">
                                                    <i class="pe-7s-notebook pe-4x"></i>
                                                </div>

                                                <h3>Easy To Use</h3>

                                            </div>

                                        </div>

                                        <div class="col-xs-6 m-padding">

                                            <div class="welcome-estate">

                                                <div class="welcome-icon">
                                                    <i class="pe-7s-help2 pe-4x"></i>
                                                </div>

                                                <h3>Any Help</h3>

                                            </div>

                                        </div>

                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

            <!-- COUNT AREA -->
            <div class="count-area">

                <div class="container">

                    <div class="row">

                        <div class="col-md-10 col-md-offset-1
                            col-sm-12 text-center page-title">

                            <h2>You Can Trust Us</h2>

                        </div>

                    </div>

                    <div class="row">

                        <div class="col-md-12 col-xs-12 percent-blocks m-main">

                            <div class="row">

                                <!-- USERS -->
                                <div class="col-sm-3 col-xs-6">

                                    <div class="count-item">

                                        <div class="count-item-circle">
                                            <span class="pe-7s-users"></span>
                                        </div>

                                        <div class="chart">

                                            <h2 class="percent">
                                                @ViewBag.TotalUsers
                                            </h2>

                                            <h5>REGISTERED USERS</h5>

                                        </div>

                                    </div>

                                </div>

                                <!-- LISTINGS -->
                                <div class="col-sm-3 col-xs-6">

                                    <div class="count-item">

                                        <div class="count-item-circle">
                                            <span class="pe-7s-home"></span>
                                        </div>

                                        <div class="chart">

                                            <h2 class="percent">
                                                @ViewBag.TotalListings
                                            </h2>

                                            <h5>PROPERTIES POSTED</h5>

                                        </div>

                                    </div>

                                </div>

                                <!-- APPROVED -->
                                <div class="col-sm-3 col-xs-6">

                                    <div class="count-item">

                                        <div class="count-item-circle">
                                            <span class="pe-7s-check"></span>
                                        </div>

                                        <div class="chart">

                                            <h2 class="percent">
                                                @ViewBag.ApprovedListings
                                            </h2>

                                            <h5>APPROVED LISTINGS</h5>

                                        </div>

                                    </div>

                                </div>

                                <!-- CITIES -->
                                <div class="col-sm-3 col-xs-6">

                                    <div class="count-item">

                                        <div class="count-item-circle">
                                            <span class="pe-7s-map-marker"></span>
                                        </div>

                                        <div class="chart">

                                            <h2 class="percent">
                                                @ViewBag.TotalCities
                                            </h2>

                                            <h5>CITIES COVERED</h5>

                                        </div>

                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

            <!-- BOY SALE AREA -->
            <div class="boy-sale-area">

                <div class="container">

                    <div class="row">

                        <!-- BUY -->
                        <div class="col-md-6 col-sm-10 col-sm-offset-1
                            col-md-offset-0 col-xs-12">

                            <div class="asks-first">

                                <div class="asks-first-circle">
                                    <span class="fa fa-search"></span>
                                </div>

                                <div class="asks-first-info">

                                    <h2>ARE YOU LOOKING FOR A PROPERTY?</h2>

                                    <p>
                                        Find your dream property easily.
                                    </p>

                                </div>

                            </div>

                        </div>

                        <!-- SELL -->
                        <div class="col-md-6 col-sm-10 col-sm-offset-1
                            col-xs-12 col-md-offset-0">

                            <div class="asks-first">

                                <div class="asks-first-circle">
                                    <span class="fa fa-usd"></span>
                                </div>

                                <div class="asks-first-info">

                                    <h2>DO YOU WANT TO SELL A PROPERTY?</h2>

                                    <p>
                                        Post your property and reach more buyers.
                                    </p>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>

            </div>