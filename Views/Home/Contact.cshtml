@model RealEstatePortal.Models.ContactMessage

@{
    Layout = "~/Views/Shared/_LayoutHome.cshtml";
}

<style>
    input.input-validation-error,
    textarea.input-validation-error {
        border-color: #dc3545 !important;
        background-color: #fff5f5 !important;
        box-shadow: none !important;
    }

    .cf-form-group {
        margin-bottom: 20px;
    }

        .cf-form-group label {
            font-size: 13px;
            font-weight: 600;
            margin-bottom: 7px;
            display: block;
            color: #444;
        }

        .cf-form-group .form-control {
            height: 42px;
            font-size: 14px;
            border-radius: 8px;
            border: 1px solid #ddd;
            padding: 8px 12px;
            transition: border-color 0.2s;
        }

        .cf-form-group textarea.form-control {
            height: auto;
        }

        .cf-form-group .form-control:focus {
            border-color: #f0c228;
            box-shadow: 0 0 0 3px rgba(240, 194, 40, 0.15);
            outline: none;
        }

    .cf-error-slot {
        min-height: 20px;
        margin-top: 5px;
        font-size: 12px;
        color: #dc3545;
        display: block;
    }

    .cf-val-box {
        background: #fff5f5;
        border: 1px solid #f5c6cb;
        border-radius: 8px;
        padding: 12px 16px;
        margin-bottom: 24px;
    }

        .cf-val-box ul {
            margin: 0;
            padding-left: 18px;
        }

            .cf-val-box ul li {
                font-size: 13px;
                color: #dc3545;
                line-height: 1.9;
            }
</style>

<div class="page-head">
    <div class="container">
        <div class="row">
            <div class="page-head-content">
                <h1 class="page-title">Contact page</h1>
            </div>
        </div>
    </div>
</div>

<div class="content-area recent-property padding-top-40"
     style="background-color:#FFF;">

    <div class="container">
        <div class="row">
            <div class="col-md-8 col-md-offset-2">
                <div id="contact1" style="padding:30px 0;">

                    <!-- SUCCESS MESSAGE -->
                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success"
                             style="border-radius:8px;
                            font-size:14px;
                            padding:14px 18px;
                            margin-bottom:28px;">
                            <i class="fa fa-check-circle"
                               style="margin-right:6px;"></i>
                            @TempData["Success"]
                        </div>
                    }

                    <!-- HEADING -->
                    <h2 style="margin-bottom:24px;
                        font-size:22px;
                        color:#1a1a2e;">
                        Contact form
                    </h2>

                    <form asp-action="Contact" method="post">

                        <!-- VALIDATION SUMMARY -->
                        @if (!ViewData.ModelState.IsValid)
                        {
                            <div class="cf-val-box">
                                <div asp-validation-summary="ModelOnly"
                                     class="text-danger"
                                     style="margin:0; font-size:13px;">
                                </div>
                            </div>
                        }

                        <div class="row">

                            <!-- FIRST NAME -->
                            <div class="col-sm-6">
                                <div class="cf-form-group">
                                    <label>Firstname</label>
                                    <input asp-for="FirstName"
                                           class="form-control"
                                           placeholder="Enter first name" />
                                    <span asp-validation-for="FirstName"
                                          class="cf-error-slot"></span>
                                </div>
                            </div>

                            <!-- LAST NAME -->
                            <div class="col-sm-6">
                                <div class="cf-form-group">
                                    <label>Lastname</label>
                                    <input asp-for="LastName"
                                           class="form-control"
                                           placeholder="Enter last name" />
                                    <span asp-validation-for="LastName"
                                          class="cf-error-slot"></span>
                                </div>
                            </div>

                            <!-- EMAIL -->
                            <div class="col-sm-6">
                                <div class="cf-form-group">
                                    <label>Email</label>
                                    <input asp-for="Email"
                                           class="form-control"
                                           placeholder="Enter email address" />
                                    <span asp-validation-for="Email"
                                          class="cf-error-slot"></span>
                                </div>
                            </div>

                            <!-- SUBJECT -->
                            <div class="col-sm-6">
                                <div class="cf-form-group">
                                    <label>Subject</label>
                                    <input asp-for="Subject"
                                           class="form-control"
                                           placeholder="Enter subject" />
                                    <span class="cf-error-slot"></span>
                                </div>
                            </div>

                            <!-- MESSAGE -->
                            <div class="col-sm-12">
                                <div class="cf-form-group">
                                    <label>Message</label>
                                    <textarea asp-for="Message"
                                              class="form-control"
                                              rows="5"
                                              placeholder="Write your message here..."></textarea>
                                </div>
                            </div>

                            <!-- BUTTON -->
                            <div class="col-sm-12 text-center"
                                 style="margin-top:10px;
                                margin-bottom:10px;">
                                <button type="submit"
                                        style="background:#f0c228;
                                    color:#1a1a2e;
                                    border:none;
                                    padding:13px 40px;
                                    border-radius:50px;
                                    font-weight:600;
                                    font-size:15px;
                                    cursor:pointer;
                                    letter-spacing:0.3px;">
                                    <i class="fa fa-envelope-o"
                                       style="margin-right:6px;"></i>
                                    Send Message
                                </button>
                            </div>

                        </div>

                    </form>

                    <hr style="margin-top:40px;
                    margin-bottom:40px;
                    border-color:#eee;" />

                    <!-- CONTACT DETAILS -->
                    <div class="row" style="margin-bottom:40px;">

                        <!-- ADDRESS -->
                        <div class="col-sm-4"
                             style="margin-bottom:20px;">
                            <div style="background:#f8f8f8;
                                border-radius:10px;
                                padding:25px;
                                height:100%;
                                border-top:4px solid #f0c228;">
                                <h4 style="color:#1a1a2e;
                                    font-weight:700;
                                    margin-top:0;
                                    margin-bottom:14px;
                                    font-size:15px;">
                                    <i class="fa fa-map-marker"
                                       style="color:#f0c228;
                                    margin-right:6px;"></i>
                                    Address
                                </h4>
                                <p style="color:#666;
                                    line-height:1.9;
                                    margin:0;
                                    font-size:13px;">
                                    13/25 Street <br />
                                    Karachi <br />
                                    45Y 73J <br />
                                    <strong>Pakistan</strong>
                                </p>
                            </div>
                        </div>

                        <!-- CALL CENTER -->
                        <div class="col-sm-4"
                             style="margin-bottom:20px;">
                            <div style="background:#f8f8f8;
                                border-radius:10px;
                                padding:25px;
                                height:100%;
                                border-top:4px solid #f0c228;">
                                <h4 style="color:#1a1a2e;
                                    font-weight:700;
                                    margin-top:0;
                                    margin-bottom:14px;
                                    font-size:15px;">
                                    <i class="fa fa-phone"
                                       style="color:#f0c228;
                                    margin-right:6px;"></i>
                                    Call Center
                                </h4>
                                <p style="color:#666;
                                    margin-bottom:12px;
                                    font-size:13px;
                                    line-height:1.7;">
                                    This number is toll free if calling
                                    from Great Britain otherwise please
                                    use the electronic form.
                                </p>
                                <p style="font-weight:700;
                                    color:#1a1a2e;
                                    font-size:15px;
                                    margin:0;">
                                    <i class="fa fa-phone"
                                       style="color:#f0c228;
                                    margin-right:4px;"></i>
                                    +0 333 666 1234
                                </p>
                            </div>
                        </div>

                        <!-- SUPPORT -->
                        <div class="col-sm-4"
                             style="margin-bottom:20px;">
                            <div style="background:#f8f8f8;
                                border-radius:10px;
                                padding:25px;
                                height:100%;
                                border-top:4px solid #f0c228;">
                                <h4 style="color:#1a1a2e;
                                    font-weight:700;
                                    margin-top:0;
                                    margin-bottom:14px;
                                    font-size:15px;">
                                    <i class="fa fa-envelope"
                                       style="color:#f0c228;
                                    margin-right:6px;"></i>
                                    Support
                                </h4>
                                <p style="color:#666;
                                    margin-bottom:14px;
                                    font-size:13px;
                                    line-height:1.7;">
                                    Feel free to write an email or
                                    use our electronic ticketing system.
                                </p>
                                <p style="margin:0;">
                                    <i class="fa fa-envelope-o"
                                       style="color:#f0c228;
                                    margin-right:4px;"></i>
                                    <a href="#"
                                           style="color:#1a1a2e;
                                        font-weight:600;
                                        font-size:13px;">
                                        real_estate0@gmail.com
                                    </a>
                                </p>
                            </div>
                        </div>

                    </div>

                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}