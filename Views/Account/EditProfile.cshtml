@model RealEstatePortal.Models.User

@{
    Layout = "~/Views/Shared/_LayoutMaster.cshtml";
}



<div class="container-fluid mt-4">

    <div class="row justify-content-center">

        <div class="col-lg-8">

            <!-- PROFILE CARD -->
            <div class="card shadow-sm border-0">

                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">Edit Profile</h5>
                </div>

                <div class="card-body">

                    @if (TempData["success"] != null)
                    {
                        <div id="successAlert" class="alert alert-success alert-dismissible fade show">
                            @TempData["success"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    <form method="post" asp-action="EditProfile" enctype="multipart/form-data">

                        <input type="hidden" asp-for="Id" />

                        <!-- Name -->
                        <div class="mb-3">
                            <label class="form-label">Full Name</label>
                            <input asp-for="Name" class="form-control" placeholder="Enter your name" required />
                        </div>

                        <!-- Email -->
                        <div class="mb-3">
                            <label class="form-label">Email Address</label>
                            <input asp-for="Email" class="form-control" placeholder="Enter your email" required />
                        </div>

                        @if (Model.Role == "Agent")
                        {
                            <!-- Agency Name -->
                            <div class="mb-3">
                                <label class="form-label">Agency Name</label>
                                <input asp-for="AgencyName"
                                       class="form-control"
                                       placeholder="Enter agency name" />
                            </div>

                            <!-- Office Address -->
                            <div class="mb-3">
                                <label class="form-label">Office Address</label>
                                <input asp-for="OfficeAddress"
                                       class="form-control"
                                       placeholder="Enter office address" />
                            </div>

                            <!-- WhatsApp -->
                            <div class="mb-3">
                                <label class="form-label">WhatsApp</label>
                                <input asp-for="WhatsApp"
                                       class="form-control"
                                       placeholder="03XXXXXXXXX" />
                            </div>

                            <!-- Experience -->
                            <div class="mb-3">
                                <label class="form-label">Experience (Years)</label>
                                <input asp-for="ExperienceYears"
                                       type="number"
                                       class="form-control" />
                            </div>

                            <!-- About Agent -->
                            <div class="mb-3">
                                <label class="form-label">About Agent</label>
                                <textarea asp-for="AboutAgent"
                                          class="form-control"
                                          rows="4"></textarea>
                            </div>
                        }
                        



                        @if (Model.Role == "Agent" || Model.Role == "Admin")
                        {
                            <!-- Profile Image -->
                            <div class="mb-3">

                                <label class="form-label">Profile Picture</label>

                                <input type="file"
                                       name="imageFile"
                                       class="form-control" />
                                <small class="text-muted">
                                    Upload a new image to change profile picture.
                                </small>

                            </div>

                            @if (!string.IsNullOrEmpty(Model.ProfileImage))
                            {
                                <div class="mb-3">

                                    <img src="@Model.ProfileImage"
                                         width="120"
                                         height="120"
                                         style="object-fit:cover; border-radius:50%; border:3px solid #ddd;" />

                                </div>
                            }
                        }


                        <!-- Password -->
                        <div class="mb-3">
                            <label class="form-label">New Password</label>
                            <input type="password" name="Password" class="form-control" placeholder="Leave empty if not changing" />
                        </div>

                        <!-- Buttons -->
                        <div class="d-flex justify-content-between mt-4">

                            <a asp-controller="Account"
                                   asp-action="Profile"
                                   class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-left"></i> Back
                            </a>

                            <button type="submit" class="btn btn-primary">
                                Update Profile
                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>


