@model List<RealEstatePortal.Models.Listing>

@{
    Layout = "~/Views/Shared/_LayoutMaster.cshtml";
}

<div class="container mt-4">

    <!-- Header -->
   

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3 class="fw-bold d-flex align-items-center">
            <span class="bg-success text-white rounded-circle d-flex align-items-center justify-content-center me-2"
                  style="width:35px; height:35px;">
                <i class="bi bi-check"></i>
            </span>
            Approved Listings
        </h3>
    </div>

    <!-- Empty State -->
    @if (!Model.Any())
    {
        <div class="alert alert-info text-center">
            No approved listings found.
        </div>
    }

    <div class="row">
        @foreach (var item in Model)
        {
            <div class="col-md-4 mb-4">
                <div class="card shadow-sm border-0 h-100">

                  
                    <div style="overflow:hidden;">
                        @if (item.Images != null && item.Images.Any())
                        {
                            <img src="@item.Images.First().ImagePath"
                                 class="card-img-top"
                                 style="height:200px; object-fit:cover; transition:0.3s;" />
                        }
                        else
                        {
                            <div class="bg-light d-flex align-items-center justify-content-center"
                                 style="height:200px;">
                                <span class="text-muted">No Image</span>
                            </div>
                        }
                    </div>

                    <!-- Body -->
                    <div class="card-body d-flex flex-column">

                        <!-- Title -->
                        <h5 class="fw-semibold mb-2">@item.Title</h5>

                        <!-- Price -->
                        <h6 class="text-success fw-bold mb-2">
                            Rs @item.Price
                        </h6>

                        <!-- Info -->
                        <p class="text-muted mb-2" style="font-size:14px;">
                            <i class="bi bi-tag"></i> @item.Category <br />
                            <i class="bi bi-geo-alt"></i> @item.Location
                        </p>

                        <!-- Status -->
                        <span class="badge bg-success mb-3" style="width:fit-content;">
                            Approved
                        </span>

                        <!-- Actions -->
                        <div class="mt-auto d-flex justify-content-between">

                            <a asp-action="Edit" asp-route-id="@item.Id"
                                   class="btn btn-outline-primary btn-sm">
                                <i class="bi bi-pencil"></i> Edit
                            </a>

                            <a asp-action="Delete" asp-route-id="@item.Id"
                                   class="btn btn-outline-danger btn-sm"
                                   onclick="return confirm('Are you sure?')">
                                <i class="bi bi-trash"></i> Delete
                            </a>

                        </div>

                    </div>
                </div>
            </div>
        }
    </div>

</div>