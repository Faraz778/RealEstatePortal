@model RealEstatePortal.Models.Listing

@{
    Layout = "~/Views/Shared/_LayoutMaster.cshtml";
}

<div class="container-fluid mt-3">

    <div class="row justify-content-center">
        <div class="col-lg-8">

            <!-- CARD -->
            <div class="card shadow-sm border-0">

                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">Add New Property</h5>
                </div>

                <div class="card-body">
                    @if (TempData["error"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show">

                            <i class="bi bi-exclamation-triangle me-2"></i>

                            @TempData["error"]

                            <button type="button"
                                    class="btn-close"
                                    data-bs-dismiss="alert">
                            </button>

                        </div>
                    }


                    <form method="post" asp-action="AddProperty" asp-controller="Agent" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()

                        <!-- Image Upload -->
                        <div class="mb-3">
                            <label class="form-label">Property Image</label>
                            <input asp-for="ImageFiles"
                                   type="file"
                                   class="form-control"
                                   multiple
                                   accept=".jpg,.jpeg,.png" />
                        </div>

                        <div class="row">

                            <!-- Title -->
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Title</label>
                                <input asp-for="Title" class="form-control" placeholder="Enter property title" />
                            </div>

                            <!-- Price -->
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Price</label>
                                <input asp-for="Price" type="number" step="0.01" class="form-control" placeholder="Enter price" />
                            </div>

                        </div>

                        <!-- Description -->
                        <div class="mb-3">
                            <label class="form-label">Description</label>
                            <textarea asp-for="Description" class="form-control" rows="3" placeholder="Write property details..."></textarea>
                        </div>

                        <div class="row">

                            <!-- Category -->
                            <div class="col-md-4 mb-3">
                                <label class="form-label">Category</label>
                              
                                <select asp-for="Category" class="form-select">
                                    @foreach (var cat in ViewBag.Categories)
                                    {
                                        <option value="@cat.Name">@cat.Name</option>
                                    }
                                </select>
                            </div>

                          
                            <div class="col-md-4 mb-3">
                                <label class="form-label">Purpose</label>

                                <select asp-for="Purpose" class="form-select">

                                    <option value="Sell">For Sell</option>
                                    <option value="Rent">For Rent</option>

                                </select>
                            </div>
                            <!-- City -->
                            <div class="col-md-4 mb-3">
                                <label class="form-label">City</label>
                                <select name="CityId" class="form-select">
                                    @foreach (var c in ViewBag.Cities)
                                    {
                                        <option value="@c.Id">@c.Name</option>
                                    }
                                </select>
                            </div>

                            <!-- Location -->
                            <div class="col-md-4 mb-3">
                                <label class="form-label">Location</label>
                                <input asp-for="Location" class="form-control" placeholder="Area / Street" />
                            </div>

                            <div class="col-md-12 mb-3">
                                <div class="form-check">

                                    <input asp-for="HideEmail"
                                           class="form-check-input" />

                                    <label class="form-check-label">
                                        Hide Email Address
                                    </label>

                                </div>
                            </div>


                        </div>

                        <!-- Buttons -->
                        <div class="d-flex justify-content-end gap-2 mt-3">

                            <a asp-action="Index"
                                   asp-controller="Agent"
                                   class="btn btn-outline-secondary">
                                Cancel
                            </a>

                            <button type="submit" class="btn btn-primary">
                                Save Property
                            </button>

                        </div>

                    </form>

                </div>

            </div>
        </div>
    </div>
</div>